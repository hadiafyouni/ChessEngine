@host = http://localhost:5241

### Start a new game
POST {{host}}/api/game/start
Content-Type: application/json

{ "playerColor": "white" }

### Make a move (replace gameId)
POST {{host}}/api/game/move
Content-Type: application/json

{ "gameId": "REPLACE_ME", "move": "e2e4" }

### Find the best move for a position
POST {{host}}/api/engine/move
Content-Type: application/json

{ "fen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1", "depth": 8, "timeMs": 3000 }

### Static evaluation
POST {{host}}/api/engine/evaluate
Content-Type: application/json

{ "fen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1" }

### Perft
GET {{host}}/api/engine/perft/4
