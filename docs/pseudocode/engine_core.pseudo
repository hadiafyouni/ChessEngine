        // 3. Restore captured piece (including en-passant pawn)
        // 4. Undo promotion: replace promoted piece with pawn
        // 5. Undo castling rook move
        // 6. Restore occupancy bitboards

    FUNCTION IsInCheck(color: Color) → bool:
        kingSquare = LSB(bitboards[KingOf(color)])
        RETURN IsSquareAttackedBy(kingSquare, opponent(color))

