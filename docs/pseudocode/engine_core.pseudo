// ============================================================
//  Chess.Engine.Core — Pseudo Code
//  Covers: PieceType, Move, Board, Bitboards, MoveGenerator,
//          Zobrist, BoardState
// ============================================================


// ── PieceType ────────────────────────────────────────────────
ENUM PieceType:
    None
    WhitePawn, WhiteKnight, WhiteBishop, WhiteRook, WhiteQueen, WhiteKing
    BlackPawn, BlackKnight, BlackBishop, BlackRook, BlackQueen, BlackKing


// ── Move (32-bit packed integer) ─────────────────────────────
STRUCT Move:
    // Packed layout:
    //   bits  0–5   from square   (0–63)
    //   bits  6–11  to square     (0–63)
    //   bits 12–15  flag          (see MoveFlag enum)
    //   bits 16–19  captured piece
    //   bits 20–23  promotion piece
    value: uint32

    PROPERTY From        → (value >> 0)  & 0x3F
    PROPERTY To          → (value >> 6)  & 0x3F
    PROPERTY Flag        → (value >> 12) & 0x0F
    PROPERTY Captured    → (value >> 16) & 0x0F
    PROPERTY Promotion   → (value >> 20) & 0x0F

ENUM MoveFlag:
    Quiet, DoublePush, KingsideCastle, QueensideCastle,
    Capture, EnPassant,
    KnightPromo, BishopPromo, RookPromo, QueenPromo,
    KnightPromoCapture, BishopPromoCapture, RookPromoCapture, QueenPromoCapture


// ── BoardState (snapshot for undo) ───────────────────────────
STRUCT BoardState:
    castlingRights   : uint8    // 4 bits: KQkq
    enPassantSquare  : int      // -1 if none
    halfMoveClock    : int
    capturedPiece    : PieceType
    zobristHash      : uint64


// ── Board ────────────────────────────────────────────────────
CLASS Board:
    // State
    bitboards[12]   : uint64    // one per PieceType (index = enum value)
    whitePieces     : uint64    // union of all white bitboards
    blackPieces     : uint64    // union of all black bitboards
    allPieces       : uint64    // whitePieces | blackPieces
    mailbox[64]     : PieceType // square → piece (for fast lookup)
    isWhiteTurn     : bool
    castlingRights  : uint8
    enPassantSquare : int
    halfMoveClock   : int
    fullMoveNumber  : int
    zobristHash     : uint64
    history         : Stack<BoardState>

    FUNCTION LoadFEN(fen: string):
        // Reset all bitboards and mailbox
        // Parse piece placement (rank 8 → rank 1, files a → h)
        // Set active color, castling rights, en-passant square
        // Set half-move clock and full-move number
        // Recompute occupancy bitboards
        // Compute initial Zobrist hash from scratch

    FUNCTION MakeMove(move: Move):
        // 1. Save current state to history stack
        // 2. Remove piece from 'from' square in bitboard and mailbox
        // 3. Handle captures: remove captured piece from its bitboard
        // 4. Handle en-passant: remove pawn from capture square
        // 5. Place piece on 'to' square
        // 6. Handle promotions: replace pawn with promoted piece
        // 7. Handle castling: move rook to its target square
        // 8. Update castling rights (moving king or rook revokes rights)
        // 9. Update en-passant square (set on double push, clear otherwise)
        // 10. Update half-move clock (reset on capture/pawn move)
        // 11. Flip turn; increment full-move counter if black just moved
        // 12. Update Zobrist hash incrementally

    FUNCTION UndoMove(move: Move):
