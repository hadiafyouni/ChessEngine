// ── Bitboards ────────────────────────────────────────────────
MODULE Bitboards:
    // Precomputed tables (filled at startup)
    knightAttacks[64]     : uint64
    kingAttacks[64]       : uint64
    pawnAttacks[2][64]    : uint64    // [color][square]
    rookMasks[64]         : uint64    // relevant occupancy bits
    bishopMasks[64]       : uint64
    rookMagics[64]        : uint64    // magic numbers (Romstad constants)
    bishopMagics[64]      : uint64
    rookAttackTable       : uint64[]  // indexed by magic hash
    bishopAttackTable     : uint64[]

    FUNCTION InitializeAttackTables():
        // Fill knight and king tables by hand (fixed offsets)
        // Fill pawn tables (one step diagonally per color)
        // For each square, generate rook/bishop blocker subsets,
        //   compute attacks for each subset, store at magic hash index

    FUNCTION RookAttacks(square: int, occupied: uint64) → uint64:
        index = (occupied & rookMasks[square]) * rookMagics[square] >> (64 - rookBits[square])
        RETURN rookAttackTable[square][index]

    FUNCTION BishopAttacks(square: int, occupied: uint64) → uint64:
        index = (occupied & bishopMasks[square]) * bishopMagics[square] >> (64 - bishopBits[square])
        RETURN bishopAttackTable[square][index]

    FUNCTION QueenAttacks(square, occupied) → uint64:
        RETURN RookAttacks(square, occupied) | BishopAttacks(square, occupied)

    FUNCTION LSB(bb: uint64) → int:        // index of lowest set bit
    FUNCTION PopLSB(bb: uint64) → int:     // return LSB index, clear it in bb
    FUNCTION PopCount(bb: uint64) → int:   // count set bits


// ── Zobrist ──────────────────────────────────────────────────
MODULE Zobrist:
    pieceKeys[12][64] : uint64    // random key per (piece, square)
    sideKey           : uint64    // XOR when it is black's turn
    castlingKeys[16]  : uint64    // one per castling-rights bitmask
    enPassantKeys[8]  : uint64    // one per file

    FUNCTION Initialize():
        // Fill all tables with pseudo-random uint64 values
        // (deterministic seed so hash is reproducible)

    FUNCTION ComputeHash(board: Board) → uint64:
        hash = 0
        FOR each piece on board:
            hash ^= pieceKeys[piece][square]
        IF board.isWhiteTurn == false:
            hash ^= sideKey
        hash ^= castlingKeys[board.castlingRights]
        IF board.enPassantSquare != -1:
            hash ^= enPassantKeys[File(board.enPassantSquare)]
        RETURN hash


// ── MoveGenerator ────────────────────────────────────────────
CLASS MoveGenerator:
    FUNCTION GenerateLegalMoves(board: Board) → List<Move>:
        pseudoLegal = GeneratePseudoLegalMoves(board)
        legal = []
        FOR each move IN pseudoLegal:
            board.MakeMove(move)
            IF NOT board.IsInCheck(board.previousTurn):
                legal.Add(move)
            board.UndoMove(move)
        RETURN legal

    FUNCTION GeneratePseudoLegalMoves(board: Board) → List<Move>:
        moves = []
        GeneratePawnMoves(board, moves)
        GenerateKnightMoves(board, moves)
        GenerateBishopMoves(board, moves)
        GenerateRookMoves(board, moves)
        GenerateQueenMoves(board, moves)
        GenerateKingMoves(board, moves)     // includes castling
        RETURN moves

    FUNCTION GeneratePawnMoves(board, moves):
        pawns = board.bitboards[PawnOf(board.turn)]
        WHILE pawns != 0:
            sq = PopLSB(pawns)
            // Single push (if target square is empty)
            // Double push from starting rank (if both squares empty)
            // Diagonal captures (attack table & enemy pieces)
            // En-passant capture (if enPassantSquare is in attack set)
            // Promotions when reaching back rank (4 piece choices × capture/quiet)

    FUNCTION GenerateSlidingMoves(board, moves, pieceType):
        pieces = board.bitboards[pieceType]
        WHILE pieces != 0:
            sq = PopLSB(pieces)
            attacks = AttacksFor(pieceType, sq, board.allPieces)
            attacks &= NOT board.friendlyPieces   // can't capture own pieces
            // Split into captures and quiet moves by masking with enemyPieces

    FUNCTION GenerateKingMoves(board, moves):
        sq = LSB(board.bitboards[KingOf(board.turn)])
        // Normal king moves (king attack table minus friendly squares)
        // Castling:
        //   Kingside: rights set AND squares between king and rook empty
        //             AND king not in check AND doesn't pass through check
        //   Queenside: same checks on the queenside
